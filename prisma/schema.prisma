generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  BOARD
  EXEC_BOARD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  bio           String?
  major         String?
  gradYear      Int?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  posts       Post[]
  rsvps       Rsvp[]
  attendances Attendance[]
  submissions Submission[]
}

// Required by @auth/prisma-adapter — do not rename fields.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// logica-lean: bare-minimum shape for #7 (BE 4/5/6/7) so FE has real
// endpoints to E2E test against. No engagement counts, no soft delete, no
// pagination cursor — whoever picks up the real ticket redesigns this.

model Post {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())

  rsvps       Rsvp[]
  attendances Attendance[]
}

enum RsvpStatus {
  GOING
  NOT_GOING
}

model Rsvp {
  id      String     @id @default(cuid())
  eventId String
  userId  String
  status  RsvpStatus

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Attendance {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  checkedInAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Form {
  id     String @id @default(cuid())
  slug   String @unique
  title  String

  fields      FormField[]
  submissions Submission[]
}

model FormField {
  id     String @id @default(cuid())
  formId String
  label  String
  type   String // logica-lean: free-text ("text" | "textarea" | ...), no enum/validation schema yet

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String   @id @default(cuid())
  formId    String
  userId    String
  data      Json
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SpeakerStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// logica-lean: bare-minimum shape for the speaker/guest intake addition
// (frontend#36, this repo's issue). No email-on-confirm, no calendar sync —
// whoever needs those picks it up as a follow-up.
//
// Two ways a row gets created:
// - Cold: a stranger fills out the public form start to finish. `submittedAt`
//   is set immediately.
// - Draft: a board member pre-fills whatever they already know (POST
//   /drafts) and sends the speaker `id` as a private link. `submittedAt` is
//   null until the speaker fills in the rest via POST /:id/complete.
model SpeakerSubmission {
  id           String        @id @default(cuid())
  name         String?
  email        String?
  organization String?
  referredBy   String? // e.g. "Nicolas", "Diego", or free text — not an enum, board members change
  availability Json? // array of {startDate, endDate, startTime, endTime} windows — see lib/speaker-submission.ts
  needs        String? // freeform: AV equipment, snacks, room setup, etc.
  note         String? // shared — either side can add context (e.g. "can't make Wednesday")
  publicOptIn  Boolean       @default(false)
  status       SpeakerStatus @default(PENDING)
  submittedAt  DateTime? // null = draft, still waiting on the speaker
  createdAt    DateTime      @default(now())
}
