generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  BOARD
  EXEC_BOARD
}

// MEMBER accounts sign in passwordless (UIC .edu OTP, see auth.ts) and Role
// governs what they can do. SPEAKER accounts sign in with a username +
// password instead (no .edu required) and Role is meaningless for them —
// see AUTH.md for the full design and why these are two separate systems.
enum AccountKind {
  MEMBER
  SPEAKER
}

// What someone does on the board. Purely cosmetic: it decides what gets
// pinned to the top of their dashboard, nothing else. Every BOARD/EXEC_BOARD
// account can see and do everything regardless — Role is the access control,
// Officer is just "which of this do you look at first".
enum Officer {
  PRESIDENT
  TREASURER
  SECRETARY
  OUTREACH
  OTHER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  officer       Officer?
  bio           String?
  major         String?
  gradYear      Int?
  createdAt     DateTime  @default(now())

  // --- SPEAKER accounts only (accountKind = SPEAKER) — see AUTH.md ---
  accountKind         AccountKind        @default(MEMBER)
  username            String?            @unique
  passwordHash        String? // scrypt, see lib/password.ts — never set for MEMBER accounts
  mustChangePassword  Boolean            @default(false)
  linkedin            String?
  // Resume — any signed-in user (MEMBER or SPEAKER) can attach one via
  // /api/profile/resume. ponytail: stored as bytes in Postgres, not object
  // storage — fine at this scale (a handful of small PDFs); move to Vercel
  // Blob/S3 if resumes get large or numerous.
  resumeData          Bytes?
  resumeFilename      String?
  resumeMimeType      String?
  speakerSubmissionId String?            @unique
  speakerSubmission   SpeakerSubmission? @relation(fields: [speakerSubmissionId], references: [id])

  accounts          Account[]
  sessions          Session[]
  posts             Post[]
  rsvps             Rsvp[]
  attendances       Attendance[]     @relation("Attended")
  checkIns          Attendance[]     @relation("CheckedInBy")
  submissions       Submission[]
  notifications     Notification[]
  emailPreference   EmailPreference?
  uploadedMaterials EventMaterial[]
  speakerMessages   SpeakerMessage[]
  mcpTokens         McpToken[]

  boardItems        BoardItem[] @relation("BoardItemAuthor")
  ownedBoardItems   BoardItem[] @relation("BoardItemOwner")
  frontedBoardItems BoardItem[] @relation("BoardItemPaidBy")
  stagedBoardItems  BoardItem[] @relation("BoardItemStager")
}

/**
 * A bearer token letting someone's AI agent act as them over MCP
 * (app/api/mcp). Scoped to nothing of its own — every request resolves the
 * user and re-derives what they're allowed to do, so a token can never
 * outrank the person who made it.
 * Stored as sha256, not scrypt: the secret is 256 bits of CSPRNG output,
 * so there's nothing to brute-force, and this is checked on every single
 * tool call.
 */
model McpToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Required by @auth/prisma-adapter — do not rename fields.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// logica-lean: bare-minimum shape for #7 (BE 4/5/6/7) so FE has real
// endpoints to E2E test against. No engagement counts, no soft delete, no
// pagination cursor — whoever picks up the real ticket redesigns this.

model Post {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  createdAt DateTime @default(now())
  eventId   String? // set -> this post is on that event's feed, not the general feed

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum MaterialVisibility {
  PUBLIC // shown to anyone viewing the event, signed in or not
  INTERNAL // board+ only — marketing assets, internal notes, etc.
}

// Organizer-uploaded slides/notes for an event. ponytail: same
// bytes-in-Postgres approach as User.resumeData, same ceiling/upgrade note.
model EventMaterial {
  id           String             @id @default(cuid())
  eventId      String
  uploadedById String
  filename     String
  mimeType     String
  data         Bytes
  visibility   MaterialVisibility @default(INTERNAL)
  createdAt    DateTime           @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  createdAt   DateTime  @default(now())
  remindedAt  DateTime? // set once the cron job (app/api/cron/event-reminders) has notified GOING rsvps

  rsvps       Rsvp[]
  attendances Attendance[]
  checkInCode CheckInCode?
  posts       Post[]
  materials   EventMaterial[]
  speaker     SpeakerSubmission?
  boardItems  BoardItem[]
}

enum RsvpStatus {
  GOING
  NOT_GOING
}

model Rsvp {
  id      String     @id @default(cuid())
  eventId String
  userId  String
  status  RsvpStatus

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Attendance {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  checkedInAt   DateTime @default(now())
  checkedInById String? // board member who checked them in at the door; null if they used the event code

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User  @relation("Attended", fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy User? @relation("CheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
}

// The code members enter (or scan as a QR) to check in to an event (#5).
// Separate from Event so opening check-in doesn't touch the event record.
model CheckInCode {
  eventId   String   @id
  code      String
  expiresAt DateTime

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Form {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  fields      FormField[]
  submissions Submission[]
}

model FormField {
  id     String @id @default(cuid())
  formId String
  label  String
  type   String // logica-lean: free-text ("text" | "textarea" | ...), no enum/validation schema yet

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String   @id @default(cuid())
  formId    String
  userId    String
  data      Json
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sign-in throttling per email address (#14). Kept in Postgres rather than
// memory so the limits survive restarts and hold across instances.
model SignInLimit {
  identifier   String   @id
  guesses      Int      @default(0) // code guesses since the last code was issued
  codeRequests Int      @default(0) // codes issued in the current window
  windowEndsAt DateTime
}

enum ApplicationTrack {
  GENERAL
  SOFTWARE_ENGINEER
  MENTORSHIP
}

enum ApplicationStatus {
  PENDING
  INTERVIEW
  ACCEPTED
  DECLINED
}

// Membership applications from the /join page (#27). Public submit, board review.
// Not tied to a User: applicants may not have signed in yet.
model MembershipApplication {
  id        String            @id @default(cuid())
  name      String
  email     String
  track     ApplicationTrack
  major     String?
  gradYear  Int?
  why       String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@index([email])
}

enum SpeakerStatus {
  PENDING
  CONFIRMED
  DECLINED
}

// logica-lean: bare-minimum shape for the speaker/guest intake addition
// (frontend#36, this repo's issue). No email-on-confirm, no calendar sync —
// whoever needs those picks it up as a follow-up.
//
// Two ways a row gets created:
// - Cold: a stranger fills out the public form start to finish. `submittedAt`
//   is set immediately.
// - Draft: a board member pre-fills whatever they already know (POST
//   /drafts) and sends the speaker `id` as a private link. `submittedAt` is
//   null until the speaker fills in the rest via POST /:id/complete.
model SpeakerSubmission {
  id           String        @id @default(cuid())
  name         String?
  email        String?
  organization String?
  referredBy   String? // e.g. "Nicolas", "Diego", or free text — not an enum, board members change
  availability Json? // array of {startDate, endDate, startTime, endTime} windows — see lib/speaker-submission.ts
  needs        String? // freeform: AV equipment, snacks, room setup, etc.
  note         String? // shared — either side can add context (e.g. "can't make Wednesday")
  publicOptIn  Boolean       @default(false)
  status       SpeakerStatus @default(PENDING)
  submittedAt  DateTime? // null = draft, still waiting on the speaker
  createdAt    DateTime      @default(now())

  // What the speaker is actually coming to give. The speaker names and
  // re-names this themselves; the board attaches the scheduled Event once
  // there is one, which is what turns on the talk's attendance numbers.
  talkTitle String?
  slidesUrl String? // a link, not a file — so it opens on whatever machine is in the room
  eventId   String? @unique

  // Two confirmations, in order. The candidate confirms their availability
  // is final, which is the signal the board can act on; the board then
  // confirms them (status = CONFIRMED), which promotes them to a speaker.
  // Cleared whenever the windows change, so "confirmed" never describes
  // times that have since moved.
  availabilityConfirmedAt DateTime?

  event    Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user     User? // set once EXEC_BOARD invites this speaker to the portal — see AUTH.md
  messages SpeakerMessage[]
}

/**
 * The speaker's thread with the board — one per submission, so it exists
 * from the moment there's a speaker to talk to. Everyone on the board sees
 * and answers the same thread; the speaker sees only their own.
 * `body` is stored exactly as typed, including `[[event:<id>|Label]]`
 * references — resolving them is the reader's job (see Thread.tsx), so a
 * renamed event never rewrites what someone actually wrote.
 */
model SpeakerMessage {
  id           String   @id @default(cuid())
  submissionId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  submission SpeakerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

/**
 * Two categories to start — event reminders (what's coming up) vs
 * announcements (general club news). Split further only when a speaker
 * actually asks for finer control; see AUTH.md.
 */
model EmailPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  eventReminders Boolean @default(true)
  announcements  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * A pot of money for a term. Items draw it down; what's left is computed,
 * never stored, so a corrected amount can't leave a stale balance behind.
 * See budgetRollup() in lib/board-item.ts.
 */
model Budget {
  id          String   @id @default(cuid())
  label       String // "Fall 2026"
  amountCents Int
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())

  items BoardItem[]
}

/**
 * One thing the board is tracking. A spend and a company we're talking to are
 * the same shape — a title, a stage, whose move it is, and when — so they're
 * one table with two kinds rather than two near-identical ones. The UI renders
 * both from the same component; only which columns it shows differs.
 * logica-lean: no Company model. `org` is text, and a company with two
 * contacts is two rows. Add the join when someone actually needs a company
 * page with history on it.
 * logica-lean: no per-item comment thread and no audit table. `detail` plus
 * stageChangedBy/At answers "who approved this and when", which is the
 * question the treasurer actually has.
 */
model BoardItem {
  id    String        @id @default(cuid())
  kind  BoardItemKind
  title String
  // logica-lean: a validated string, not a Prisma enum. The board will rename
  // these as they learn their own process, and an enum makes every rename a
  // migration. Validated against STAGES[kind] in lib/board-item.ts.
  stage String

  detail String?

  ownerId          String? // the exec whose move it is
  nextStepAt       DateTime?
  stageChangedById String?
  stageChangedAt   DateTime?
  archivedAt       DateTime?

  // --- MONEY ---
  budgetId     String?
  amountCents  Int?
  paidByUserId String? // set => someone fronted it => it's owed back to them
  receiptUrl   String?

  // --- OUTREACH ---
  org          String?
  contactName  String?
  contactEmail String?
  channel      String? // how we reached them: LinkedIn, email, in person, a referral
  category     String? // company visit / talk / workshop / partner — the public site's own taxonomy
  link         String?
  lastTouchAt  DateTime?

  eventId     String? // the visit, talk or workshop this belongs to
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget         Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  owner          User?   @relation("BoardItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  paidBy         User?   @relation("BoardItemPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  stageChangedBy User?   @relation("BoardItemStager", fields: [stageChangedById], references: [id], onDelete: SetNull)
  createdBy      User    @relation("BoardItemAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  event          Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([kind, stage])
  @@index([ownerId])
}

enum BoardItemKind {
  MONEY
  OUTREACH
}
