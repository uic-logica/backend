# Postgres connection string (Supabase, or local Postgres for dev)
DATABASE_URL="postgresql://user:password@localhost:5555/logica"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Required — use a real domain such as uic.edu; "*" matches nothing. If unset,
# auth fails closed and rejects all sign-ins.
ALLOWED_EMAIL_DOMAIN="uic.edu"

# Public frontend origin(s) for password request origin checks (no trailing slash).
# Comma-separate several (e.g. apex + www); the first is used for redirects.
FRONTEND_URL="http://localhost:3000"

# LinkedIn OpenID Connect. The redirect URI is derived as
# <first FRONTEND_URL>/api/linkedin/callback — register exactly that in the
# LinkedIn app's Authorized redirect URLs.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- SMTP: notifications and guest invitations ----------------------------
# Any SMTP provider works; nothing here is provider-specific. Leave blank and
# member password sign-in does not depend on SMTP.
#
# Local dev: use an Ethereal sandbox mailbox — it speaks real SMTP but captures
# mail instead of delivering it, so no real inbox is involved. Generate a
# throwaway one with:
#   node -e 'require("nodemailer").createTestAccount().then(a=>console.log(a))'
# then read the mail at https://ethereal.email with the printed user/pass.
# Ethereal prunes idle mailboxes, so regenerate if sends start failing on auth.
#
# Production: Resend, installed from the Vercel Marketplace on the logica team.
# It sets RESEND_API_KEY, and lib/mailer.ts uses Resend whenever that key is
# present (the EMAIL_SERVER_* values below are then ignored). Mail goes out as
# hello@logicauic.org, with SPF/DKIM records for logicauic.org in Cloudflare so
# it reaches @uic.edu inboxes. Replies go to EMAIL_REPLY_TO.
#   EMAIL_FROM="LOGICA @ UIC <hello@logicauic.org>"
#   EMAIL_REPLY_TO="logica.uic@gmail.com"
#
# Without RESEND_API_KEY (local dev), plain SMTP from the values below.
EMAIL_SERVER_HOST=""     # smtp.gmail.com (prod) / smtp.ethereal.email (dev)
EMAIL_SERVER_PORT=""     # e.g. 587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""            # on Gmail SMTP it must match EMAIL_SERVER_USER
EMAIL_REPLY_TO=""        # optional; where replies go
RESEND_API_KEY=""        # set by the Resend integration on Vercel; leave empty locally

# Optional — set on Vercel and locally will 401 without it (leave unset in
# local dev to skip auth entirely on the cron endpoint). Vercel sends this
# automatically as `Authorization: Bearer $CRON_SECRET` on scheduled runs
# once you set the env var — see vercel.json and app/api/cron/event-reminders.
CRON_SECRET=""

# --- Google Drive: the board's document tab -------------------------------
# All three or none. Unset, /api/board/documents returns
# `{ configured: false }` and the dashboard says so instead of erroring — so
# the rest of the board workspace works without any of this.
#
# Via a service account rather than per-user OAuth: every exec
# already shares one Drive, so per-person consent buys nothing. Setup, once:
#   1. Google Cloud console -> new project -> enable the Google Drive API.
#   2. Create a service account, then a JSON key. `client_email` and
#      `private_key` from that file are the two values below.
#   3. In Drive, add that client_email to the club's shared drive (UIC LOGICA)
#      as Content manager: Documents reads it, and Money saves receipt photos
#      into Receipts/<YYYY-MM>. It can see nothing else in anyone's Drive.
#   4. The id is the last path segment of the shared drive's URL.
# The key is a PEM with newlines; most dashboards can't hold real newlines,
# so paste it with literal \n — lib/drive.ts accepts either.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""   # logica-dashboard@<project>.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=""     # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""    # the shared drive (or folder) the service account is in
