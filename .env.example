# Postgres connection string (Neon via Vercel Marketplace, or local Postgres for dev)
DATABASE_URL="postgresql://user:password@localhost:5432/logica"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Restrict sign-in to this email domain (leave unset to allow any Google account)
ALLOWED_EMAIL_DOMAIN="uic.edu"
