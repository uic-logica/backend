# Postgres connection string (Supabase, or local Postgres for dev)
DATABASE_URL="postgresql://user:password@localhost:5432/logica"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Required — sign-in is restricted to this email domain; if unset, auth fails closed and rejects all sign-ins
ALLOWED_EMAIL_DOMAIN="uic.edu"

# --- SMTP: sends the one-time sign-in code ---------------------------------
# Any SMTP provider works; nothing here is provider-specific. Leave blank and
# auth.ts throws on the first send rather than silently dropping codes.
#
# Local dev: use an Ethereal sandbox mailbox — it speaks real SMTP but captures
# mail instead of delivering it, so no real inbox is involved. Generate a
# throwaway one with:
#   node -e 'require("nodemailer").createTestAccount().then(a=>console.log(a))'
# then read the mail at https://ethereal.email with the printed user/pass.
# Ethereal prunes idle mailboxes, so regenerate if sends start failing on auth.
#
# Production (current): a dedicated Gmail account, logica.noreply@gmail.com —
# not anyone's personal mail and not the shared club inbox, so 2-Step
# Verification could be enabled on it without disrupting anybody. Ask a
# maintainer for the App Password; it is a 16-character value from
# https://myaccount.google.com/apppasswords, not the account password.
#   EMAIL_SERVER_HOST="smtp.gmail.com"
#   EMAIL_SERVER_PORT="587"
#   EMAIL_SERVER_USER="logica.noreply@gmail.com"
#   EMAIL_FROM="LOGICA @ UIC <logica.noreply@gmail.com>"
#
# EMAIL_FROM must be the authenticated Gmail address. Gmail rewrites the From
# header to the account that authenticated unless the address is a verified
# "Send mail as" alias, so a made-up sender silently becomes this one.
#
# Verified 2026-08-31: delivers to the @uic.edu inbox, not spam. Recheck if
# codes start going missing — Gmail's free tier caps around 500 recipients/day
# and reputation can shift.
#
# This is a stopgap. When the club has its own domain (the public website needs
# one anyway), move to a transactional provider with SPF/DKIM on that domain,
# so sign-in mail comes from LOGICA rather than a gmail.com address that looks
# like phishing. Only these five values change — no code change either way.
EMAIL_SERVER_HOST=""     # smtp.gmail.com (prod) / smtp.ethereal.email (dev)
EMAIL_SERVER_PORT=""     # e.g. 587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""            # must match EMAIL_SERVER_USER on Gmail

# Optional — set on Vercel and locally will 401 without it (leave unset in
# local dev to skip auth entirely on the cron endpoint). Vercel sends this
# automatically as `Authorization: Bearer $CRON_SECRET` on scheduled runs
# once you set the env var — see vercel.json and app/api/cron/event-reminders.
CRON_SECRET=""

# --- Google Drive: the board's document tab -------------------------------
# All three or none. Unset, /api/board/documents returns
# `{ configured: false }` and the dashboard says so instead of erroring — so
# the rest of the board workspace works without any of this.
#
# Read-only, via a service account rather than per-user OAuth: every exec
# already shares one Drive, so per-person consent buys nothing. Setup, once:
#   1. Google Cloud console -> new project -> enable the Google Drive API.
#   2. Create a service account, then a JSON key. `client_email` and
#      `private_key` from that file are the two values below.
#   3. In Drive, share the club's LOGICA folder with that client_email as
#      Viewer. The account can see nothing else in anyone's Drive.
#   4. The folder id is the last path segment of the folder's URL.
# The key is a PEM with newlines; most dashboards can't hold real newlines,
# so paste it with literal \n — lib/drive.ts accepts either.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""   # logica-dashboard@<project>.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=""     # "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=""    # the folder shared with the service account
